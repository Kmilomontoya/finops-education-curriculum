# FINOPS EDUCATION CURRICULUM — PUBLIC CONFIGURATION EXAMPLE
# Copy this file to .env and configure local paths. Never commit the real .env.

# Input directory. Expected:
# - one optional .xlsx roster (NAME/ROLE/TITLE or supported aliases)
# - one or more CSV exports from the Microsoft FinOps assessment / FinOps Review
INPUT_DIR=input

# Generated curriculum workbooks
OUTPUT_DIR=output

# Exact roster workbook name. Blank = first .xlsx found in INPUT_DIR
ARCHIVO_PERSONAS=

# Week 1 date (DD/MM/YYYY). Blank = next Monday
FECHA_INICIO=

# Base output filename; generation date is appended automatically
NOMBRE_SALIDA=FinOps_Education_Curriculum.xlsx
